---
import ThemeToggle from '../components/ThemeToggle.astro';
const TITLE = 'Personal Notes';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{TITLE}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a href="/" class="brand">
          <span class="brand-dot" />
          <span class="brand-text">Notes</span>
        </a>
        <nav class="nav">
          <a href="/app" class="nav-item">All Notes</a>
          <a href="/app/tags" class="nav-item">Tags</a>
          <a href="/app/categories" class="nav-item">Categories</a>
          <a href="/app/account" class="nav-item">Account</a>
        </nav>
        <footer class="sidebar-footer">
          <a href="/help" class="help-link">Help</a>
        </footer>
      </aside>
      <main class="main">
        <header class="header">
          <div class="header-left">
            <h1>{TITLE}</h1>
          </div>
          <div class="header-actions">
            <a href="/app/new" class="btn btn-accent">New Note</a>
            <a href="/auth/logout" class="btn btn-outline">Logout</a>
          </div>
        </header>
        <section class="content">
          <slot />
        </section>
        <footer class="footer">
          <p>Need help? Check the <a href="/help">guide</a>.</p>
        </footer>
      </main>
    </div>
    <ThemeToggle />
  </body>
</html>

<style>
  :root {
    --color-primary: #2D9CDB;
    --color-secondary: #56CCF2;
    --color-accent: #F2994A;

    --bg-color: #ffffff;
    --text-color: #111827;
    --text-secondary: #4b5563;
    --border-color: rgba(0, 0, 0, 0.1);
    --card-bg: rgba(255, 255, 255, 1);
    --card-hover-bg: rgba(255, 255, 255, 0.55);
    --shadow-color: rgba(0, 0, 0, 0.08);
    --shadow-hover-color: rgba(0, 0, 0, 0.14);
  }

  body.dark-theme {
    --bg-color: #0f172a;
    --text-color: #f8fafc;
    --text-secondary: #cbd5e1;
    --border-color: rgba(255, 255, 255, 0.15);
    --card-bg: rgba(2, 6, 23, 0.75);
    --card-hover-bg: rgba(2, 6, 23, 0.55);
    --shadow-color: rgba(0, 0, 0, 0.35);
    --shadow-hover-color: rgba(0, 0, 0, 0.45);
  }

  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, var(--bg-color), color-mix(in srgb, var(--bg-color) 85%, var(--color-secondary)));
    color: var(--text-color);
    transition: background-color 0.3s ease, color 0.3s ease;
    font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji", "Segoe UI Emoji";
  }

  .app-shell {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: 100dvh;
  }

  .sidebar {
    border-right: 1px solid var(--border-color);
    padding: 20px 16px;
    background: var(--card-bg);
    backdrop-filter: blur(10px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-color);
    text-decoration: none;
    font-weight: 700;
    font-size: 20px;
    margin-bottom: 22px;
  }
  .brand-dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: inline-block;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .nav-item {
    color: var(--text-color);
    text-decoration: none;
    padding: 10px 12px;
    border-radius: 8px;
    transition: background 0.2s ease;
  }
  .nav-item:hover {
    background: color-mix(in srgb, var(--color-secondary) 15%, var(--card-bg));
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px dashed var(--border-color);
  }
  .help-link { color: var(--color-primary); text-decoration: none; }

  .main {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100dvh;
  }

  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    background: var(--card-bg);
  }
  .header h1 {
    font-size: 18px;
    margin: 0;
  }
  .header-actions {
    display: flex;
    gap: 10px;
  }

  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    height: 36px; padding: 0 14px;
    border-radius: 10px;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    background: var(--card-bg);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn:hover { box-shadow: 0 4px 10px var(--shadow-hover-color); transform: translateY(-1px); }
  .btn-accent {
    background: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent), #000 12%);
    color: #111827;
  }
  .btn-outline {
    background: transparent;
  }

  .content {
    padding: 16px;
  }

  .footer {
    padding: 12px 16px;
    border-top: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 14px;
    background: var(--card-bg);
  }

  @media (max-width: 900px) {
    .app-shell { grid-template-columns: 1fr; }
    .sidebar { display: none; }
    .header-actions { gap: 6px; }
    .btn { height: 34px; padding: 0 12px; }
  }
</style>
