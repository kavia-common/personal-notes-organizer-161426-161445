---
import Layout from '../layouts/Layout.astro';

const isAuthed = false;
if (!isAuthed) {
  // Render a minimal landing with calls to action
}
---

<Layout>
  <section class="landing">
    <div class="hero">
      <h2>Organize your thoughts</h2>
      <p>Create, tag, and find your notes fast. Minimal UI, maximum focus.</p>
      <div class="cta">
        <a href="/auth/login" class="btn btn-accent">Login</a>
        <a href="/auth/register" class="btn">Register</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .landing {
    display: grid; place-items: center;
    min-height: calc(100dvh - 140px);
  }
  .hero { text-align: center; max-width: 620px; }
  .hero h2 { font-size: 32px; margin: 0 0 8px; }
  .hero p { font-size: 16px; color: var(--text-secondary); margin: 0 0 16px; }
  .cta { display: inline-flex; gap: 12px; }
</style>
