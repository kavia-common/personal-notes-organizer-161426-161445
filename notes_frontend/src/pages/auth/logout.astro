---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <section class="auth">
    <div class="card">
      <h3>Logging out...</h3>
      <p class="hint">You will be redirected shortly.</p>
    </div>
  </section>
</Layout>

<style>
  .auth { display: grid; place-items: center; min-height: calc(100dvh - 140px); }
  .card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 20px; width: 100%; max-width: 380px; box-shadow: 0 10px 28px var(--shadow-color); text-align: center; }
  .hint { color: var(--text-secondary); }
</style>

<script>
  import { logout } from '../../lib/auth';
  logout();
  setTimeout(() => { location.href = '/'; }, 600);
</script>
