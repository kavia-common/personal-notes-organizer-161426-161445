# PUBLIC INTERFACE
# Frontend environment variables required by the Notes app.
# Copy this file to `.env` and fill in the values before running locally.

# Base URL to the backend API (e.g., http://localhost:8000 or https://api.example.com)
PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: Enable debug logging in the frontend
PUBLIC_DEBUG=false

# Optional: OAuth provider names if integrated later (comma-separated)
PUBLIC_AUTH_PROVIDERS=
